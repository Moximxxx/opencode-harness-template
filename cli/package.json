{
  "name": "create-opencode-harness",
  "version": "1.0.0",
  "description": "交互式 CLI 工具，从 GitHub 拉取 opencode-harness-template 工作流模板并配置到当前项目",
  "type": "module",
  "bin": {
    "create-opencode-harness": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "inquirer": "^9.0.0",
    "chalk": "^5.0.0",
    "ora": "^7.0.0",
    "tar": "^6.0.0",
    "adm-zip": "^0.5.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/tar": "^6.0.0",
    "@types/adm-zip": "^0.5.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
